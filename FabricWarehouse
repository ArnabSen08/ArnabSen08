Task 3 Query: 
-- Step 1: Create the schema
CREATE SCHEMA DW;

-- Step 2: Create the dimension table
CREATE TABLE DW.DimProduct AS
SELECT 
    P.*,                                
    PC.Name AS Subcategory,             
    PSC.SupplierCode                    
FROM 
    SalesLT.Product AS P
LEFT JOIN 
    SalesLT.ProductCategory AS PC 
    ON P.ProductCategoryID = PC.ProductCategoryID
LEFT JOIN 
    ProductSupplierCode AS PSC 
    ON LEFT(P.ProductNumber, 2) = PSC.ProductCode
    AND PSC.ProductSupplierCodeID = (
        SELECT TOP 1 ProductSupplierCodeID 
        FROM ProductSupplierCode AS PSC2 
        WHERE LEFT(P.ProductNumber, 2) = PSC2.ProductCode
        ORDER BY ProductSupplierCodeID
    );
